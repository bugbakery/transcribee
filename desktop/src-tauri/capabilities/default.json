{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "document/*",
    "new_document_dialog"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "dialog:default",
    "log:default",
    "opener:default",
    "shell:default",
    "store:default",
    "window-state:default"
  ]
}
